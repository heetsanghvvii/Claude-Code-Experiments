# Copy to .env (gitignored). Values come from your Supabase project settings.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: build-time only, used by app.config.ts. Leave empty to use Apple Maps on iOS.
GOOGLE_MAPS_IOS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=
