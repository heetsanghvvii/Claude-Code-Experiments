{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/crm",
      "destination": "/crm/index.html"
    },
    {
      "source": "/start",
      "destination": "/start/index.html"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "outreach/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "30 3 * * *"
    }
  ]
}
