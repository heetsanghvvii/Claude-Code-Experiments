{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/crm",
      "destination": "/crm/index.html"
    },
    {
      "source": "/start",
      "destination": "/start/index.html"
    },
    {
      "source": "/portal",
      "destination": "/portal/index.html"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "outreach/**"
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "30 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/portal(.*)",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
