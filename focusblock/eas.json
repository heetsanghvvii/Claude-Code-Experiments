{
  "cli": {
    "version": ">= 12.0.0"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "developmentClient": true,
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      }
    },
    "standalone": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "tester": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_TEST_MODE": "1"
      },
      "android": {
        "buildType": "apk"
      }
    }
  }
}