{
  "expo": {
    "name": "Nope",
    "slug": "focusblock",
    "scheme": "focusblock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourname.focusblock",
      "entitlements": {
        "com.apple.developer.family-controls": true
      },
      "infoPlist": {
        "NSFamilyControlsUsageDescription": "Nope blocks the apps you choose while your Nope is on."
      }
    },
    "android": {
      "package": "com.yourname.focusblock",
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-dev-client",
      ["expo-build-properties", { "ios": { "deploymentTarget": "16.4" } }],
      ["react-native-nfc-manager", { "nfcPermission": "Nope reads your NFC sticker to lock and unlock apps." }]
    ]
  }
}
