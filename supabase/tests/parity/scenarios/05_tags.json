[
  {
    "name": "tag-runner-ack",
    "description": "A tag alone never eliminates; only the tagged runner can acknowledge; ack confirms, eliminates, and rejects other pending tags on that runner; idempotent",
    "config": { "durationS": 600, "headStartS": 60, "snapshotIntervalS": 30 },
    "users": ["h1", "h2", "r1", "r2", "r3"],
    "steps": [
      { "at": 0, "do": "create", "as": "h1" },
      { "at": 1, "do": "join", "as": "h2" },
      { "at": 2, "do": "join", "as": "r1" },
      { "at": 3, "do": "join", "as": "r2" },
      { "at": 4, "do": "join", "as": "r3" },
      { "at": 4, "do": "setRole", "as": "h1", "player": "h1", "role": "HUNTER" },
      { "at": 4, "do": "setRole", "as": "h1", "player": "h2", "role": "HUNTER" },
      { "at": 4, "do": "setRole", "as": "h1", "player": "r1", "role": "RUNNER" },
      { "at": 4, "do": "setRole", "as": "h1", "player": "r2", "role": "RUNNER" },
      { "at": 4, "do": "setRole", "as": "h1", "player": "r3", "role": "RUNNER" },
      { "at": 5, "do": "start", "as": "h1" },
      { "at": 80, "do": "tag", "as": "h1", "tag": "t1", "runner": "r1", "expect": { "tags": { "t1": { "status": "PENDING", "hunter": "h1", "runner": "r1", "createdAt": 80, "resolvedAt": null } }, "players": { "r1": "ACTIVE" } } },
      { "at": 81, "do": "tag", "as": "h2", "tag": "t2", "runner": "r1", "expect": { "events": ["TAG_REQUESTED:t2"] } },
      { "at": 82, "do": "ack", "as": "h1", "tag": "t1", "expect": { "error": "NOT_RUNNER" } },
      { "at": 82, "do": "ack", "as": "r2", "tag": "t1", "expect": { "error": "NOT_RUNNER" } },
      { "at": 82, "do": "ack", "as": "r1", "tag": "t9", "expect": { "error": "TAG_NOT_FOUND" } },
      { "at": 85, "do": "ack", "as": "r1", "tag": "t1", "expect": { "tags": { "t1": { "status": "CONFIRMED", "confirmation": "RUNNER_ACK", "resolvedAt": 85 }, "t2": { "status": "REJECTED", "resolvedAt": 85 } }, "players": { "r1": { "status": "ELIMINATED", "eliminatedAt": 85 } }, "status": "ACTIVE", "events": ["TAG_CONFIRMED:t1", "PLAYER_ELIMINATED:r1", "TAG_REJECTED:t2"] } },
      { "at": 86, "do": "ack", "as": "r1", "tag": "t1", "expect": { "ok": true, "events": [] } },
      { "at": 86, "do": "ack", "as": "r1", "tag": "t2", "expect": { "error": "TAG_NOT_PENDING" } },
      { "at": 86, "do": "withdraw", "as": "h1", "tag": "t1", "expect": { "error": "TAG_NOT_PENDING" } },
      { "at": 87, "do": "tag", "as": "h1", "tag": "t3", "runner": "r1", "expect": { "error": "TARGET_NOT_ACTIVE" } },
      { "at": 90, "do": "tag", "as": "h1", "tag": "t4", "runner": "r2" },
      { "at": 91, "do": "withdraw", "as": "h2", "tag": "t4", "expect": { "error": "NOT_HUNTER" } },
      { "at": 91, "do": "withdraw", "as": "h1", "tag": "t4", "expect": { "tags": { "t4": { "status": "REJECTED", "resolvedAt": 91 } }, "events": ["TAG_REJECTED:t4"] } },
      { "at": 92, "do": "withdraw", "as": "h1", "tag": "t4", "expect": { "ok": true, "events": [] } },
      { "at": 92, "do": "ack", "as": "r2", "tag": "t4", "expect": { "error": "TAG_NOT_PENDING", "players": { "r2": "ACTIVE" } } }
    ]
  },
  {
    "name": "tag-idempotency",
    "description": "submit_tag is idempotent on the client tag id; reuse with other players is a conflict, also after the game ends",
    "config": { "durationS": 600, "headStartS": 60, "snapshotIntervalS": 30 },
    "users": ["h1", "h2", "r1", "r2"],
    "steps": [
      { "at": 0, "do": "create", "as": "h1" },
      { "at": 1, "do": "join", "as": "h2" },
      { "at": 2, "do": "join", "as": "r1" },
      { "at": 3, "do": "join", "as": "r2" },
      { "at": 4, "do": "setRole", "as": "h1", "player": "h1", "role": "HUNTER" },
      { "at": 4, "do": "setRole", "as": "h1", "player": "h2", "role": "HUNTER" },
      { "at": 4, "do": "setRole", "as": "h1", "player": "r1", "role": "RUNNER" },
      { "at": 4, "do": "setRole", "as": "h1", "player": "r2", "role": "RUNNER" },
      { "at": 5, "do": "start", "as": "h1" },
      { "at": 80, "do": "tag", "as": "h1", "tag": "t1", "runner": "r1" },
      { "at": 81, "do": "tag", "as": "h1", "tag": "t1", "runner": "r1", "expect": { "ok": true, "events": [], "tags": { "t1": { "createdAt": 80 } } } },
      { "at": 81, "do": "tag", "as": "h1", "tag": "t1", "runner": "r2", "expect": { "error": "TAG_CONFLICT" } },
      { "at": 81, "do": "tag", "as": "h2", "tag": "t1", "runner": "r1", "expect": { "error": "TAG_CONFLICT" } },
      { "at": 82, "do": "tag", "as": "r1", "tag": "t1", "runner": "r1", "expect": { "error": "TAG_CONFLICT" } },
      { "at": 85, "do": "ack", "as": "r1", "tag": "t1" },
      { "at": 86, "do": "tag", "as": "h1", "tag": "t1", "runner": "r1", "expect": { "ok": true, "events": [] } },
      { "at": 90, "do": "tag", "as": "h2", "tag": "t2", "runner": "r2" },
      { "at": 91, "do": "ack", "as": "r2", "tag": "t2", "expect": { "status": "COMPLETED", "winner": "HUNTERS" } },
      { "at": 92, "do": "tag", "as": "h2", "tag": "t2", "runner": "r2", "expect": { "ok": true, "events": [] } },
      { "at": 92, "do": "tag", "as": "h2", "tag": "t2", "runner": "r1", "expect": { "error": "TAG_CONFLICT" } },
      { "at": 92, "do": "tag", "as": "h2", "tag": "t3", "runner": "r1", "expect": { "error": "GAME_FINISHED" } }
    ]
  },
  {
    "name": "tag-expiry",
    "description": "A pending tag expires tag_confirm_window (60 s) after it was made, exactly at the boundary; an ack at or after that is too late",
    "config": { "durationS": 600, "headStartS": 60, "snapshotIntervalS": 30 },
    "users": ["h1", "r1", "r2"],
    "steps": [
      { "at": 0, "do": "create", "as": "h1" },
      { "at": 1, "do": "join", "as": "r1" },
      { "at": 2, "do": "join", "as": "r2" },
      { "at": 3, "do": "setRole", "as": "h1", "player": "h1", "role": "HUNTER" },
      { "at": 3, "do": "setRole", "as": "h1", "player": "r1", "role": "RUNNER" },
      { "at": 3, "do": "setRole", "as": "h1", "player": "r2", "role": "RUNNER" },
      { "at": 5, "do": "start", "as": "h1" },
      { "at": 100, "do": "tag", "as": "h1", "tag": "t1", "runner": "r1" },
      { "at": 159, "do": "advance", "as": "h1", "expect": { "tags": { "t1": "PENDING" } } },
      { "at": 160, "do": "advance", "as": "h1", "expect": { "tags": { "t1": { "status": "EXPIRED", "resolvedAt": 160 } }, "events": ["TAG_EXPIRED:t1"] } },
      { "at": 161, "do": "ack", "as": "r1", "tag": "t1", "expect": { "error": "TAG_NOT_PENDING", "players": { "r1": "ACTIVE" } } },
      { "at": 161, "do": "withdraw", "as": "h1", "tag": "t1", "expect": { "error": "TAG_NOT_PENDING" } },
      { "at": 170, "do": "tag", "as": "h1", "tag": "t2", "runner": "r2" },
      { "at": 230, "do": "ack", "as": "r2", "tag": "t2", "expect": { "error": "TAG_NOT_PENDING", "tags": { "t2": "PENDING" }, "players": { "r2": "ACTIVE" } } },
      { "at": 230, "do": "advance", "as": "r2", "expect": { "tags": { "t2": { "status": "EXPIRED", "resolvedAt": 230 } } } },
      { "at": 231, "do": "tag", "as": "h1", "tag": "t3", "runner": "r2", "expect": { "tags": { "t3": "PENDING" } } },
      { "at": 290, "do": "ack", "as": "r2", "tag": "t3", "expect": { "tags": { "t3": "CONFIRMED" }, "players": { "r2": "ELIMINATED" } } }
    ]
  },
  {
    "name": "tag-expiry-at-deadline",
    "description": "Tags whose window closes before the deadline expire at window end; tags still pending at the deadline expire at the deadline; the deadline is hard",
    "config": { "durationS": 600, "headStartS": 60, "snapshotIntervalS": 30 },
    "users": ["h1", "r1", "r2"],
    "steps": [
      { "at": 0, "do": "create", "as": "h1" },
      { "at": 1, "do": "join", "as": "r1" },
      { "at": 2, "do": "join", "as": "r2" },
      { "at": 3, "do": "setRole", "as": "h1", "player": "h1", "role": "HUNTER" },
      { "at": 3, "do": "setRole", "as": "h1", "player": "r1", "role": "RUNNER" },
      { "at": 3, "do": "setRole", "as": "h1", "player": "r2", "role": "RUNNER" },
      { "at": 5, "do": "start", "as": "h1" },
      { "at": 554, "do": "tag", "as": "h1", "tag": "t1", "runner": "r1" },
      { "at": 580, "do": "tag", "as": "h1", "tag": "t2", "runner": "r2" },
      { "at": 615, "do": "ack", "as": "r2", "tag": "t2", "expect": { "error": "GAME_FINISHED", "status": "ACTIVE" } },
      { "at": 700, "do": "advance", "as": "h1", "expect": { "status": "COMPLETED", "winner": "RUNNERS", "endReason": "TIME_EXPIRED", "times": { "endedAt": 615 }, "tags": { "t1": { "status": "EXPIRED", "resolvedAt": 614 }, "t2": { "status": "EXPIRED", "resolvedAt": 615 } }, "events": ["TAG_EXPIRED:t1", "TAG_EXPIRED:t2", "GAME_COMPLETED"] } }
    ]
  }
]
