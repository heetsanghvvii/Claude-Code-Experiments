<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <queries>
    <intent>
      <action android:name="android.intent.action.MAIN" />
      <category android:name="android.intent.category.LAUNCHER" />
    </intent>
  </queries>
  <application>
    <activity
      android:name="expo.modules.appblocker.BlockedActivity"
      android:exported="false"
      android:excludeFromRecents="true"
      android:launchMode="singleTask"
      android:taskAffinity=""
      android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />
    <service
      android:name="expo.modules.appblocker.FocusAccessibilityService"
      android:exported="false"
      android:label="@string/focus_service_label"
      android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
      <intent-filter>
        <action android:name="android.accessibilityservice.AccessibilityService" />
      </intent-filter>
      <meta-data
        android:name="android.accessibilityservice"
        android:resource="@xml/focus_accessibility_config" />
    </service>
  </application>
</manifest>
