# Copy to integrations/.env (git-ignored). Never commit real values.

# Mode. Default (LIVE empty) is dry run: requests are printed, the network is never called.
# Set LIVE=1 to execute. Only do this when the human said so.
LIVE=

# Meta / Instagram (Graph API)
META_GRAPH_VERSION=v21.0
IG_USER_ID=
IG_ACCESS_TOKEN=
# Optional: needed only to exchange or debug tokens
META_APP_ID=
META_APP_SECRET=

# YouTube Data API v3 (OAuth2 refresh token flow)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# LinkedIn (Posts API)
LINKEDIN_ACCESS_TOKEN=
# urn:li:person:XXXX for a member, urn:li:organization:NNNN for a Page
LINKEDIN_AUTHOR_URN=
# Monthly API version header, format YYYYMM
LINKEDIN_VERSION=202506

# Optional tuning
HTTP_MAX_RETRIES=4
HTTP_TIMEOUT_MS=60000
